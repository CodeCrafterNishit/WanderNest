<% layout("/layouts/boilerplate") %>

<style>
    .filters-container{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:2rem;
}

.filters-container{
    margin: 1rem 0 2rem;
}

.filters-container{
    gap: 3rem;
}

#filters{
    display:flex;
    align-items:center;
    gap:2rem;
    overflow-x:auto;
    flex:1;
    padding:1rem 0;
}

#filters::-webkit-scrollbar{
    display:none;
}

.filter{
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0.7;
    cursor: pointer;
    min-width: 80px;
    transition: all 0.2s ease;
}

.filter:hover{
    opacity: 1;
    transform: translateY(-3px);
}

.filter i{
    font-size: 1.3rem;
    margin-bottom: 0.4rem;
    cursor: pointer;
}

.filter p{
    margin: 0;
    font-size: 0.8rem;
}

.tax-switch{
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ddd;
    border-radius: 999px;
    padding: 0.65rem 1rem;
    background: #fff;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.3s ease;
}

.tax-switch .form-check{
    display: flex;
    align-items: center;
    margin: 0;
}

.tax-switch .form-check-input{
    margin-top: 0;
}

.tax-switch .form-check-label{
    margin-bottom: 0;
    margin-left: 0.5rem;
}

.scroll-btn{
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid #ddd;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.25s ease;
}

.scroll-btn:hover{
    background-color: #f7f7f7;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    transform: scale(1.05);
}

.tax-info{
    display: none;
    color: #444;
    font-size: 0.9rem;
}

.tax-info strong{
    color:#222;
    font-weight:600;
}

.tax-text{
    color:#666;
}
</style>
<div class="filters-container">

<div id="filters">
    <i id="leftBtn" class="fa-solid fa-chevron-left"></i>
    <div class="filter">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-water"></i>
        <p>Beach</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-snowflake"></i>
        <p>Arctic</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-tree"></i>
        <p>Forest</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Pools</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-ship"></i>
        <p>Boats</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-landmark"></i>
        <p>Historical</p>
    </div>

    <div class="filter">
        <i class="fa-solid fa-city"></i>
        <p>Cities</p>
    </div>

    <div class="filter">
         <i class="fa-solid fa-house"></i> 
         <p>Villas</p> 
    </div>

    <i id="rightBtn" class="fa-solid fa-chevron-right"></i>
</div>
    <div class="tax-switch">
        <div class="form-check form-switch m-0">
            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="switchCheckDefault">

            <label class="form-check-label ms-2" for="switchCheckDefault">
                Show total price
            </label>
        </div>
    </div>
</div>


<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(listing of allListings){ %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card col listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="Listing Image" style="height:20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
              <p class="card-text">
              <b><%= listing.title %></b><br>
                &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
               <span class="tax-info">
    <br>
    <strong>&#8377;<%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %></strong>
    <span class="tax-text"> total after taxes</span>
</span>
              </p>
             </div>
            </div>
        </a>
    <% } %>
</div>

<script>
    const filters = document.getElementById("filters");
const leftBtn = document.getElementById("leftBtn");
const rightBtn = document.getElementById("rightBtn");

    leftBtn.addEventListener("click", () => {
    filters.scrollBy({
        left: -250,
        behavior: "smooth"
    });
});

rightBtn.addEventListener("click", () => {
    filters.scrollBy({
        left: 250,
        behavior: "smooth"
    });
});

    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("change",()=>{
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo){
            if(info.style.display != "inline"){
                info.style.display = "inline";
            }else{
                info.style.display = "none";
            }
        }
    });
</script>