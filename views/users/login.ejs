<%layout("/layouts/boilerplate")%>
<body>
  <div class="row mt-3">
    <div class="col-6 offset-3">
      <h3 class="col-6 offset-3">Login on WanderNest</h3>
      <form action="/login" method="POST" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input
            type="text"
            name="username"
            id="username"
            class="form-control"
            required
          />
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input
            type="password"
            name="password"
            id="password"
            class="form-control"
            required
          />
        </div>

        <button class="btn btn-dark edit-btn mt-3 mb-2">Login</button>
      </form>
    </div>
  </div>
</body>
